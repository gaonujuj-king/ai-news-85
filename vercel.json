{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "routes": [
    { "src": "/login", "dest": "/api/login" },
    { "src": "/logout", "dest": "/api/logout" },
    { "src": "/", "dest": "/api/app?path=index.html" },
    { "src": "/(.*)", "dest": "/api/app?path=$1" }
  ],
  "functions": {
    "api/app.js": {
      "includeFiles": "docs/**"
    }
  }
}
